# HTTP
PORT=3000
NODE_ENV=development

# Runtime environment: SANDBOX or PRODUCTION
# Keep SANDBOX until production credentials and endpoint are explicitly provisioned.
ENVIRONMENT=SANDBOX

# SATUSEHAT Control Plane PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=satusehat_control
PGUSER=postgres
PGPASSWORD=change-me

# Khanza MySQL/MariaDB - READ ONLY account
KHANZA_DB_HOST=127.0.0.1
KHANZA_DB_PORT=3306
KHANZA_DB_NAME=sik
KHANZA_DB_USER=readonly_satusehat
KHANZA_DB_PASSWORD=change-me
KHANZA_DB_SSL=false

# SATUSEHAT master switch
SATUSEHAT_ENABLED=false

# Patient creation is opt-in. Keep false for MONITORING_ONLY operation.
SATUSEHAT_PATIENT_CREATE_ENABLED=false

# SANDBOX credentials/configuration
SATUSEHAT_SANDBOX_BASE_URL=
SATUSEHAT_SANDBOX_AUTH_URL=
SATUSEHAT_SANDBOX_CLIENT_ID=
SATUSEHAT_SANDBOX_CLIENT_SECRET=
SATUSEHAT_SANDBOX_ORGANIZATION_ID=

# PRODUCTION credentials/configuration
# Do not commit real production secrets to GitHub.
SATUSEHAT_PRODUCTION_BASE_URL=
SATUSEHAT_PRODUCTION_AUTH_URL=
SATUSEHAT_PRODUCTION_CLIENT_ID=
SATUSEHAT_PRODUCTION_CLIENT_SECRET=
SATUSEHAT_PRODUCTION_ORGANIZATION_ID=

# Backward-compatible SANDBOX aliases (optional)
SATUSEHAT_BASE_URL=
SATUSEHAT_AUTH_URL=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
